{
    "name": "hefesto/flota-vehiculos",
    "type": "project",
    "description": "API de Gestion de Flota de Vehiculos de Hefesto Studio. Software propio de Hefesto: el centro del producto son los vencimientos de los documentos de cada vehiculo, no las reparaciones.",
    "keywords": ["hefesto", "flota", "vehiculos", "vencimientos", "documentos", "multitenant", "laravel", "postgres", "rls"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-openssl": "*",
        "laravel/framework": "^12.0",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear",
            "@php artisan test"
        ],
        "test:aislamiento": [
            "@php artisan test --testsuite=Aislamiento"
        ],
        "test:alertas": [
            "@php artisan test --testsuite=Alertas"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}