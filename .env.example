# =============================================================================
# Gestión de Flota de Vehículos · Hefesto Studio
# Plantilla de variables de entorno.
#
# ESTE ARCHIVO NO TIENE NINGÚN VALOR REAL.
# Copiar a `.env` y completar. El `.env` nunca se sube al repositorio: está en
# el `.gitignore`.
#
# Para generar APP_KEY:
#   docker compose -f deploy/compose.desarrollo.yaml run --rm api php artisan key:generate
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
APP_NOMBRE="Flota de Vehículos"
APP_ENV=local
APP_DEBUG=true
# Idioma y zona horaria del proceso. El cálculo de vencimientos usa la zona
# horaria del TENANT (columna `tenants.zona_horaria`), no esta: esta es solo la
# del contenedor.
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Santiago
APP_LOCALE=es_CL

# Clave de cifrado de la aplicación.
# Generar con `php artisan key:generate`. Sin ella la aplicación NO arranca.
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# -----------------------------------------------------------------------------
# `flota_app` es el rol de APLICACIÓN. IMPORTANTE: este rol NO puede ser
# superusuario ni tener BYPASSRLS. Con cualquiera de las dos cosas, PostgreSQL
# ignora todas las políticas de Row Level Security y el aislamiento entre
# flotas desaparece en silencio.
# La comprobación la hace `php artisan flota:verificar-aislamiento`.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=flota
DB_USERNAME=flota_app
DB_PASSWORD=

# Rol de migración. Solo se usa para `artisan migrate`. Puede tener más
# privilegios porque no lo usa la aplicación en producción. Aun así, no
# debería ser superusuario: sin él, las políticas se pueden aplicar y
# verificar.
DB_MIGRATION_USERNAME=flota_migrator
DB_MIGRATION_PASSWORD=

# -----------------------------------------------------------------------------
# Caché y colas (Redis)
# -----------------------------------------------------------------------------
# Redis sostiene dos cosas que no son un caché opcional:
#   - el candado `withoutOverlapping` de la tarea programada de alertas
#   - `onOneServer()`, que evita que dos réplicas generen los mismos avisos
# Si Redis cae, la tarea programada se bloquea. Es un punto único de falla
# asumido a conciencia, porque su alternativa (generar avisos sin candado)
# duplica los avisos.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# -----------------------------------------------------------------------------
# Autenticación (Authentik, OpenID Connect)
# -----------------------------------------------------------------------------
# El token se recibe en el login y se guarda como hash SHA-256 en `usuarios`.
# Ver docs/05-CONFIGURACION.md.
AUTHENTIK_URL=https://autenticacion.ejemplo.cl
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Restringir el acceso a ciertos dominios de correo. Vacío = sin restricción.
# Con varios: "empresa.cl,Transportista.cl"
FLOTA_DOMINIOS_PERMITIDOS=

# -----------------------------------------------------------------------------
# Correo
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=alertas@ejemplo.cl
MAIL_FROM_NAME="Flota de Vehículos"

# -----------------------------------------------------------------------------
# Vencimientos y alertas
# -----------------------------------------------------------------------------
# Zona horaria para calcular "cuántos días faltan". Es la fecha del TENANT la
# que manda; esto es el valor por defecto.
FLOTA_ZONA_HORARIA=America/Santiago

# Expresión de cron de la tarea que genera las alertas. Por defecto, todos los
# días a las 06:00 hora de Chile: cuando el operador ya está trabajando y
# todavía tiene tiempo de gestionar el documento antes de que salga el
# vehículo.
FLOTA_PROGRAMACION_ALERTAS="0 10 * * *"

# Minutos que puede quedar tomado el candado de la tarea antes de que otra
# ejecución pueda entrar. Si una ejecución se cuelga, esta es la ventana para
# recuperarla.
FLOTA_CANDADO_ALERTAS_MINUTOS=30

# Envío de alertas.
#
# EN `false` (valor por defecto, y recomendado para el primer despliegue), el
# generador crea y guarda las alertas, y NO despacha correos. Los avisos se
# ven en el tablero. Ponerlo en `true` solo después de tener probada la cadena
# completa de entrega: SMTP, remitente, cola y worker.
FLOTA_ALERTAS_ENVIO_ACTIVO=false

# Litros mínimos para calcular rendimiento de combustible. Con menos, el número
# es ruido estadístico y el sistema no lo muestra.
FLOTA_LITROS_MINIMOS_RENDIMIENTO=5

# Tamaño de página por defecto en los listados.
FLOTA_POR_PAGINA=25

# -----------------------------------------------------------------------------
# Frontend (Nuxt)
# -----------------------------------------------------------------------------
# URL interna de la API desde el contenedor web.
FLOTA_API_BASE=http://api:8000
# Valores públicos del frontend: son visibles para el navegador por diseño.
# No hay ningún secreto aquí: la autenticación ocurre en Authentik.
NUXT_PUBLIC_AUTHENTIK_URL=https://autenticacion.ejemplo.cl
NUXT_PUBLIC_AUTHENTIK_CLIENT_ID=